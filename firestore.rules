rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return resource.data.ownerUid == request.auth.uid; }
    match /families/default/products/{productId} { allow read, create, update, delete: if signedIn(); }
    match /families/default/superExpenses/{expenseId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && isOwner();
      allow update: if false;
    }
    match /families/default/monthlyExpenses/{expenseId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && isOwner();
      allow update: if false;
    }
    match /families/default/meta/{documentId} {
      allow read, write: if signedIn();
    }
  }
}
