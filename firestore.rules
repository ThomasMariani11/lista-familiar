rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyMember() {
      return signedIn() && request.auth.token.email in [
        'thomi@lista-familiar.app',
        'mati@lista-familiar.app',
        'delfi@lista-familiar.app',
        'mama@lista-familiar.app'
      ];
    }
    function isThomi() { return request.auth.token.email == 'thomi@lista-familiar.app'; }
    function isOwner() { return resource.data.ownerUid == request.auth.uid; }
    function validAuthor() {
      return (
        (request.auth.token.email == 'thomi@lista-familiar.app' && request.resource.data.usuarioId == 'thomi') ||
        (request.auth.token.email == 'mati@lista-familiar.app' && request.resource.data.usuarioId == 'mati') ||
        (request.auth.token.email == 'delfi@lista-familiar.app' && request.resource.data.usuarioId == 'delfi') ||
        (request.auth.token.email == 'mama@lista-familiar.app' && request.resource.data.usuarioId == 'mama')
      );
    }
    match /families/default/products/{productId} { allow read, create, update, delete: if familyMember(); }
    match /families/default/superExpenses/{expenseId} {
      allow read: if familyMember();
      allow create: if familyMember() && validAuthor() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if familyMember() && isOwner();
      allow update: if false;
    }
    match /families/default/monthlyExpenses/{expenseId} {
      allow read: if familyMember();
      allow create: if familyMember() && !isThomi() && validAuthor() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if familyMember() && isOwner();
      allow update: if false;
    }
    match /families/default/meta/monthlyBudgets {
      allow read: if familyMember();
      allow write: if familyMember() && isThomi();
    }
    match /families/default/meta/{documentId} {
      allow read: if familyMember();
      allow write: if familyMember() && documentId != 'monthlyBudgets';
    }
  }
}
